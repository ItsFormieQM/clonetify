/// @desc Takes an array of full file paths and returns a new array containing only the clean filenames.
/// @param {Array} path_array The array of absolute paths generated by Java.
function scr_strip_dir(path_array) {
    if (!is_array(path_array)) return [];
    
    var _len = array_length(path_array);
    var _clean_titles_list = array_create(_len); // Allocate memory slots instantly to maximize loop speeds
    
    for (var i = 0; i < _len; i++) {
        var _full_path = path_array[i];
        
        // Find the position index tracking location of the very last forward slash character
        var _last_slash_pos = string_last_pos("/", _full_path);
        
        if (_last_slash_pos > 0) {
            // Slice the text string block cleanly from right after the slash straight to the end
            var _filename_only = string_delete(_full_path, 1, _last_slash_pos);
            _clean_titles_list[i] = _filename_only;
        } else {
            // Fallback mapping guard condition if the string doesn't track a structural slash partition
            _clean_titles_list[i] = _full_path;
        }
    }
    
    return _clean_titles_list;
}
